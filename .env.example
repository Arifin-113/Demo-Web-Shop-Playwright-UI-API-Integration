# Copy this file to ".env" in the project root. ".env" is gitignored.

# Target site (the public Tricentis Demo Web Shop is the only environment)
BASE_URL=https://demowebshop.tricentis.com/

# Password given to every user the tests register (each test registers its own fresh user)
TEST_USER_PASSWORD=Test@12345

# Domain for generated e-mail addresses: <prefix>_<timestamp>_<random>@<domain>
TEST_EMAIL_DOMAIN=mailinator.com

# Log level for framework logs: debug | info | warn | error
LOG_LEVEL=info

# Run browsers headed locally (true/false). CI always runs headless.
HEADLESS=true

# Set by CI runners: enables retries and fewer workers (see playwright.config.js)
# CI=true
